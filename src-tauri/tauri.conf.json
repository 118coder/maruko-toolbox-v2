{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小丸工具箱V2现代版",
  "version": "2.0.0",
  "identifier": "com.maruko.v2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "width": 432,
        "height": 300,
        "center": true,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "main",
        "url": "index.html",
        "width": 648,
        "height": 650,
        "minWidth": 580,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "title": "小丸工具箱V2现代版",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "E:\\maruko-build\\icons\\32x32.png",
      "E:\\maruko-build\\icons\\128x128.png",
      "E:\\maruko-build\\icons\\128x128@2x.png",
      "E:\\maruko-build\\icons\\icon.ico",
      "E:\\maruko-build\\icons\\icon.png"
    ]
  }
}
